<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Ufbx</RootNamespace>
    <AssemblyName>Ufbx</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <!-- The data model lives in Model/ (split by element category, audited against ufbx.h).
       An older single-file `Types.cs` port duplicated 274 of those type definitions and was
       moved to _quarantine/Types.duplicate.cs.txt for arbitration; it is NOT compiled.
       Do not re-add a `<Compile Remove="Model\**\*.cs" />` unless that quarantine file is
       restored as src/Ufbx/Types.cs and its unique members are merged first. -->
</Project>
