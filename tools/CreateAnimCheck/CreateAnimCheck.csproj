<Project Sdk="Microsoft.NET.Sdk">
  <!-- Isolated verification for batch K (the animation-creation chain). Not part of ufbx.net.sln.
       Replays the record stream of tools/create_anim_oracle.c (built with zig, #include "ufbx.c")
       through src/Ufbx.NET/Parse/CreateAnim.cs + UfbxApi.CreateAnim and compares every record of the
       grammar documented in the oracle header. Also serves as the mutation-test rig. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>CreateAnimCheck</RootNamespace>
    <AssemblyName>CreateAnimCheck</AssemblyName>
    <RollForward>LatestMajor</RollForward>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <NoWarn>CS0168;CS0219;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Ufbx.NET\**\*.cs" Exclude="..\..\src\Ufbx.NET\bin\**;..\..\src\Ufbx.NET\obj\**;..\..\src\Ufbx.NET\_quarantine\**" />
    <Compile Include="..\..\tests\Ufbx.NET.Tests\HashScene.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
