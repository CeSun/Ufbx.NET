<Project Sdk="Microsoft.NET.Sdk">
  <!-- Isolated verifier for the ported scene hash (tests/Ufbx.NET.Tests/HashScene.cs):
       compiles ONLY the model/math files the hash needs, so it builds even while
       Parse/Util are mid-flight. Not part of ufbx.net.sln on purpose. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Ufbx.NET.Tests</RootNamespace>
    <RollForward>LatestMajor</RollForward>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Ufbx.NET\Enums.cs" />
    <Compile Include="..\..\src\Ufbx.NET\Math\Types.cs" />
    <Compile Include="..\..\src\Ufbx.NET\Math\UfbxBitUtil.cs" />
    <Compile Include="..\..\src\Ufbx.NET\Math\UfbxFma.cs" />
    <Compile Include="..\..\src\Ufbx.NET\Math\UfbxMath.cs" />
    <Compile Include="..\..\src\Ufbx.NET\Model\**\*.cs" />
    <Compile Include="..\..\tests\Ufbx.NET.Tests\HashScene.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
