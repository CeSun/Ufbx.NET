<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bit-exactness harness for the ported load spine: replays the per-file records of
       tools/load_oracle.c (output tools/load_oracle.txt, path list tools/load_corpus.txt) against
       UfbxiLoad.Load / UfbxApi.LoadFile and classifies each file. Not part of ufbx-cs.sln, like
       tools/UtilCheck.
       Usage: dotnet run project tools/LoadCheck with the oracle output tools/load_oracle.txt -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>LoadCheck</RootNamespace>
    <AssemblyName>LoadCheck</AssemblyName>
    <RollForward>LatestMajor</RollForward>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Ufbx\**\*.cs" Exclude="..\..\src\Ufbx\bin\**;..\..\src\Ufbx\obj\**;..\..\src\Ufbx\_quarantine\**" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
