<Project Sdk="Microsoft.NET.Sdk">
  <!-- S1 self-check harness (owned by the S1 agent). Drives the ported load spine over corpus
       files and reports, per file, whether `ufbxi_read_root` completed (the driver's
       `SceneBuild` seam is exactly the post-ReadRoot marker), which deep reader seam was hit,
       or which parse error occurred; plus the S1 counters on success.
       Not part of ufbx-cs.sln, like tools/LoadCheck and tools/GraphCheck. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>S1SelfCheck</RootNamespace>
    <AssemblyName>S1SelfCheck</AssemblyName>
    <RollForward>LatestMajor</RollForward>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Ufbx\**\*.cs" Exclude="..\..\src\Ufbx\bin\**;..\..\src\Ufbx\obj\**;..\..\src\Ufbx\_quarantine\**" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
