Connections:  {
	; Model hierarchy
	C: "OO",100001,100000
	C: "OO",100002,100000
	C: "OO",100003,100000
	C: "OO",100004,100000

	; Geometry -> Model
	C: "OO",200000,100003
	C: "OO",200001,100004

	; Skin deformers -> the GEOMETRIES (that is how every real exporter connects them; a
	; Deformer:: whose parent is the Model does not resolve). TwoSkins gets TWO on purpose.
	C: "OO",300000,200000
	C: "OO",300001,200000
	C: "OO",300002,200001

	; Clusters -> skins
	C: "OO",400000,300000
	C: "OO",400001,300001
