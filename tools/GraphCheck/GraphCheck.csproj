<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bit-exactness harness for the ported S1 pipeline (element / property / connection graph):
       replays the records of tools/graph_oracle.c (output tools/graph_oracle.txt, path list
       tools/graph_corpus.txt) from the ported parser and diffs them record by record.
       Not part of ufbx.net.sln, like tools/LoadCheck and tools/DomCheck.
       Usage: dotnet run project tools/GraphCheck after building with the oracle path as arg. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>GraphCheck</RootNamespace>
    <AssemblyName>GraphCheck</AssemblyName>
    <RollForward>LatestMajor</RollForward>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Ufbx.NET\**\*.cs" Exclude="..\..\src\Ufbx.NET\bin\**;..\..\src\Ufbx.NET\obj\**;..\..\src\Ufbx.NET\_quarantine\**" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
