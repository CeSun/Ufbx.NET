<Project Sdk="Microsoft.NET.Sdk">
  <!-- Isolated differential verification for the S3b/S3c scene finalize + update modules.
       Not part of ufbx.net.sln. Drives the ported load spine over the input/answer corpus of
       tools/s3bc_oracle.c (built with zig, #include "ufbx.c"). Also serves as the
       mutation-test rig (see the S3b/S3c report). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>S3bcCheck</RootNamespace>
    <AssemblyName>S3bcCheck</AssemblyName>
    <RollForward>LatestMajor</RollForward>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Ufbx.NET\**\*.cs" Exclude="..\..\src\Ufbx.NET\bin\**;..\..\src\Ufbx.NET\obj\**;..\..\src\Ufbx.NET\_quarantine\**" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
