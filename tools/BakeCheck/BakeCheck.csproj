<Project Sdk="Microsoft.NET.Sdk">
  <!-- Isolated verification for batch J (the animation-baking chain). Not part of ufbx-cs.sln.
       Replays the record stream of tools/bake_oracle.c (built with zig, #include "ufbx.c") through
       src/Ufbx/Parse/Bake.cs + src/Ufbx/Api/UfbxBakeApi.cs and compares every record of the
       grammar documented in the oracle header. Also serves as the mutation-test rig. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>BakeCheck</RootNamespace>
    <AssemblyName>BakeCheck</AssemblyName>
    <RollForward>LatestMajor</RollForward>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <NoWarn>CS0168;CS0219;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Ufbx\**\*.cs" Exclude="..\..\src\Ufbx\bin\**;..\..\src\Ufbx\obj\**;..\..\src\Ufbx\_quarantine\**" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
