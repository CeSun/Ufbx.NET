<Project Sdk="Microsoft.NET.Sdk">
  <!-- Isolated verification for the S4c topology / normals / triangulation module
       (Parse/Topology.cs). Not part of ufbx.net.sln. The C# port cannot load FBX files yet
       (toplevel reader seam unported), so tools/s4c_oracle.c (zig, #include "ufbx.c") dumps
       both the loaded mesh definition (VP/VPI/F/VTX/VFI/ED/ES/FS/VNV/VNI records, bit-exact)
       and the S4c outputs (TOP/MAP/NRM/TRI/WFN) for every mesh of the corpus. This harness
       reconstructs each mesh from the definition records, runs the ported functions and
       compares the output records byte for byte.
       Also serves as the mutation-test rig (see the S4c report). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>S4cCheck</RootNamespace>
    <AssemblyName>S4cCheck</AssemblyName>
    <RollForward>LatestMajor</RollForward>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Ufbx.NET\**\*.cs" Exclude="..\..\src\Ufbx.NET\bin\**;..\..\src\Ufbx.NET\obj\**;..\..\src\Ufbx.NET\_quarantine\**" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
