<Project Sdk="Microsoft.NET.Sdk">
  <!-- Isolated verifier: compiles only the ported math subset so the 72000-vector
       comparison can run even while other in-flight modules break the main build.
       Not part of ufbx.net.sln on purpose. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Ufbx.NET.Tests</RootNamespace>
    <RollForward>LatestMajor</RollForward>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Ufbx.NET\Math\UfbxBitUtil.cs" />
    <Compile Include="..\..\src\Ufbx.NET\Math\UfbxMath.cs" />
    <Compile Include="..\..\src\Ufbx.NET\Math\UfbxFma.cs" />
    <Compile Include="..\..\tests\Ufbx.NET.Tests\MathVectorCheck.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
