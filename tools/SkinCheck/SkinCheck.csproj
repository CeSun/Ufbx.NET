<Project Sdk="Microsoft.NET.Sdk">
  <!-- Isolated verification for batch N (the skinning evaluation body on the evaluate path).
       Not part of ufbx.net.sln. Replays the record stream of tools/skin_oracle.c (built with zig,
       #include "ufbx.c") through src/Ufbx.NET/Parse/SceneOpts.cs (UfbxiSceneOpts.EvaluateSkinning) as
       driven from src/Ufbx.NET/Parse/EvaluateScene.cs and src/Ufbx.NET/Parse/Load.cs, and compares every
       record of the grammar documented in the oracle header. Also serves as the mutation rig. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SkinCheck</RootNamespace>
    <AssemblyName>SkinCheck</AssemblyName>
    <RollForward>LatestMajor</RollForward>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <NoWarn>CS0168;CS0219;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Ufbx.NET\**\*.cs" Exclude="..\..\src\Ufbx.NET\bin\**;..\..\src\Ufbx.NET\obj\**;..\..\src\Ufbx.NET\_quarantine\**" />
    <Compile Include="..\..\tests\Ufbx.NET.Tests\HashScene.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
