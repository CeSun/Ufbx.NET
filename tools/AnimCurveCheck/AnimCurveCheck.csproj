<Project Sdk="Microsoft.NET.Sdk">
  <!-- Isolated verifier for the S2 animation tangent solvers: replays the records of
       tools/animcurve_oracle.c (output tools/animcurve_oracle.txt) against the ported
       UfbxiAnimReader solvers and compares IEEE-754 bit patterns. Not part of ufbx.net.sln
       (template: tools/MathVectorCheck / tools/DomCheck). The oracle is built with
       -mcpu=x86_64 and -ffp-contract=off (see PORTING_NOTES.md).
       Usage: dotnet run (project tools/AnimCurveCheck) with the oracle path -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AnimCurveCheck</RootNamespace>
    <AssemblyName>AnimCurveCheck</AssemblyName>
    <RollForward>LatestMajor</RollForward>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Ufbx.NET\**\*.cs" Exclude="..\..\src\Ufbx.NET\bin\**;..\..\src\Ufbx.NET\obj\**;..\..\src\Ufbx.NET\_quarantine\**" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
