<Project Sdk="Microsoft.NET.Sdk">
  <!-- Isolated verification for the S3a scene-build helpers (Parse/SceneBuild.cs). Not part of
       ufbx-cs.sln. Drives the ported comparators / binary-search helpers / stable sorts directly
       over the input/answer corpus of tools/s3_oracle.c (built with zig, #include "ufbx.c").
       Also serves as the mutation-test rig (see the S3a report). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>S3SceneCheck</RootNamespace>
    <AssemblyName>S3SceneCheck</AssemblyName>
    <RollForward>LatestMajor</RollForward>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Ufbx\**\*.cs" Exclude="..\..\src\Ufbx\bin\**;..\..\src\Ufbx\obj\**;..\..\src\Ufbx\_quarantine\**" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
